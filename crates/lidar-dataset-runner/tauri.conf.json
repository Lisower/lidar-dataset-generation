{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiDAR Dataset Runner",
  "version": "0.1.0",
  "identifier": "ru.lidar.datasetrunner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiDAR Dataset Runner",
        "width": 1200,
        "height": 800
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "resources": { "../../presets/": "presets/" }
  }
}
